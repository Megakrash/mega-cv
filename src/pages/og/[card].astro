---
/*
 * Link preview cards (Open Graph images), captured to PNG by `pnpm cv`
 * (scripts/cv.ts) at OG_SIZE, into src/assets/og/. Like the CV print page,
 * only the `cv-print` build renders them: the site's own build emits no card.
 *
 * Dark theme only, the site's identity. Content stays clear of the edges:
 * some apps crop previews.
 */
import '@fontsource-variable/geist'
import '@fontsource-variable/geist-mono'
import geistLatinUrl from '@fontsource-variable/geist/files/geist-latin-wght-normal.woff2?url'
import geistMonoLatinUrl from '@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url'
import { Image } from 'astro:assets'

import screenshot from '../../assets/mega-series/collection.webp'
import photo from '../../assets/photo.jpg'
import TagList from '../../components/TagList.astro'
import TerminalWindow from '../../components/TerminalWindow.astro'
import { MEGA_SERIES } from '../../data/mega-series'
import { PROFILE, PROJECTS } from '../../data/profile'
import { LANGS, UI, type Lang } from '../../i18n/ui'
import { CV_PRINT_MODE } from '../../lib/cv'
import { OG_CARDS, ogCardId, type OgCard } from '../../lib/og'
import '../../styles/global.css'

export function getStaticPaths() {
  if (import.meta.env.MODE !== CV_PRINT_MODE) return []
  return OG_CARDS.flatMap((card) =>
    LANGS.map((lang) => ({ params: { card: ogCardId(card, lang) }, props: { card, lang } }))
  )
}

interface Props {
  card: OgCard
  lang: Lang
}

const { card, lang } = Astro.props
const t = UI[lang]
const profile = PROFILE[lang]
const site = Astro.site
if (!site) throw new Error('`site` must be set in astro.config.mjs (shown on the cards).')

const project = PROJECTS.find((item) => item.name === 'mega-series')
if (!project) throw new Error('mega-series is missing from PROJECTS (src/data/profile.ts).')
---

<!doctype html>
<html lang={lang} data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <title>{ogCardId(card, lang)}</title>
    {[geistLatinUrl, geistMonoLatinUrl].map((url) => (
      <link rel="preload" href={url} as="font" type="font/woff2" crossorigin />
    ))}
  </head>
  <body>
    <div class="card">
      <div class="bar">
        <span class="logo">
          <span class="accent">~/</span>jonathan
        </span>
        <span class="host">{site.hostname}</span>
      </div>

      {card === 'home' ? (
        <div class="home">
          <div class="avatar">
            <Image src={photo} width={400} height={400} alt="" loading="eager" />
          </div>
          <div class="home__text">
            <p class="name">{profile.name}</p>
            <p class="job">
              {profile.jobTitle}
              <span class="cursor">▍</span>
            </p>
            <p class="tagline">{profile.tagline}</p>
            <p class="badge">
              <span class="dot" />
              {profile.status} · {profile.lookingFor}
            </p>
          </div>
        </div>
      ) : (
        <div class="project">
          <div class="project__text">
            <p class="path">{MEGA_SERIES.path[lang]}</p>
            <p class="project__name">{project.name}</p>
            <p class="badge">
              <span class="dot" />
              {t.inProduction}
            </p>
            <p class="pitch">{MEGA_SERIES.pitch[lang]}</p>
          </div>
          <div class="project__shot">
            <TerminalWindow title="mega-series.fr/collection" flush>
              <Image src={screenshot} width={1200} alt="" loading="eager" />
            </TerminalWindow>
          </div>
          <div class="project__stack">
            <TagList items={project.stack.slice(0, 8)} />
          </div>
        </div>
      )}
    </div>
  </body>
</html>

<style>
  /* Larger rem: the reused components (terminal window, tags) scale with it. */
  html {
    font-size: 22px;
  }
  body {
    display: block;
    min-height: 0;
  }

  /* OG_SIZE of src/lib/og.ts. */
  .card {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-direction: column;
    width: 1200px;
    height: 630px;
    padding: 56px 72px;
    overflow: hidden;
    background: var(--color-bg);
    --grid-line: color-mix(in srgb, var(--color-text) 7%, transparent);
  }
  /* The hero's faint grid and orange glow from the top. */
  .card::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--grid-line) 1px, transparent 1px),
      linear-gradient(90deg, var(--grid-line) 1px, transparent 1px);
    background-size: 48px 48px;
    mask-image: radial-gradient(ellipse 75% 75% at 50% 40%, #000 20%, transparent 80%);
  }
  .card::after {
    content: '';
    position: absolute;
    inset: 0 0 auto;
    z-index: -1;
    height: 480px;
    background: radial-gradient(ellipse 60% 100% at 50% 0%, rgb(248 155 34 / 22%), transparent 70%);
  }

  p {
    margin: 0;
  }

  .bar {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    font-family: var(--font-mono);
  }
  .logo {
    font-size: 30px;
    font-weight: 600;
  }
  .accent {
    color: var(--color-accent-text);
  }
  .host {
    color: var(--color-muted);
    font-size: 24px;
  }

  .badge {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    align-self: flex-start;
    padding: 8px 18px;
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    background: color-mix(in srgb, var(--color-surface) 80%, transparent);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 22px;
  }
  .dot {
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--color-accent);
  }

  /* Home page card */
  .home {
    display: flex;
    flex: 1;
    align-items: center;
    gap: 56px;
  }
  .avatar {
    flex: none;
    width: 248px;
    padding: 8px;
    border: 4px solid var(--color-accent);
    border-radius: 50%;
  }
  .avatar img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 50%;
  }
  .home__text {
    display: flex;
    flex-direction: column;
    gap: 14px;
  }
  .name {
    font-size: 76px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .job {
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: 38px;
    font-weight: 500;
    line-height: 1.2;
  }
  .cursor {
    margin-left: 6px;
  }
  .tagline {
    margin-bottom: 18px;
    color: var(--color-muted);
    font-size: 28px;
    line-height: 1.3;
  }

  /* mega-series card */
  .project {
    display: grid;
    flex: 1;
    grid-template-columns: 1fr 560px;
    grid-template-rows: 1fr auto;
    gap: 28px 48px;
    margin-top: 32px;
    min-height: 0;
  }
  .project__text {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }
  .path {
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: 22px;
  }
  .project__name {
    font-family: var(--font-mono);
    font-size: 64px;
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1.05;
  }
  .pitch {
    font-size: 24px;
    line-height: 1.4;
  }
  .project__shot {
    align-self: start;
  }
  /* Cropped right below the first row of posters. */
  .project__shot img {
    display: block;
    width: 100%;
    height: 268px;
    object-fit: cover;
    object-position: top;
  }
  .project__stack {
    grid-column: 1 / -1;
  }
</style>
