---
import { HOME_PATHS, MEGA_SERIES_PATHS, UI, type Lang } from '../i18n/ui'

import Button from './Button.astro'
import TerminalWindow from './TerminalWindow.astro'

/**
 * Body of the 404 page of each locale, which nginx serves for any unknown
 * path (docker/nginx.conf). Its links are absolute: it shows at any depth.
 */
interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = UI[lang].notFound
---

<section class="not-found" aria-labelledby="not-found-title">
  <div class="not-found__inner container">
    <h1 class="not-found__title" id="not-found-title">
      {/* The space keeps "404" and the title apart in the heading's text. */}
      <span class="not-found__code">404</span> {t.title}
    </h1>
    <p class="not-found__text">{t.text}</p>

    <div class="not-found__terminal">
      <TerminalWindow title="zsh">
        <p class="shell__line">
          <span class="shell__prompt" aria-hidden="true">
            $
          </span>
          {t.command}
        </p>
        <p class="shell__line shell__line--error">{t.error}</p>
      </TerminalWindow>
    </div>

    <div class="not-found__actions">
      <Button href={HOME_PATHS[lang]}>{t.home}</Button>
      <Button href={MEGA_SERIES_PATHS[lang]} variant="ghost">
        {t.project}
      </Button>
    </div>
  </div>
</section>

<style>
  .not-found {
    padding-block: var(--space-8) var(--space-9);
  }
  .not-found__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-5);
  }

  .not-found__title {
    margin: 0;
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .not-found__code {
    display: block;
    margin-bottom: var(--space-2);
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: var(--text-hero);
    letter-spacing: -0.03em;
  }
  .not-found__text {
    margin: 0;
    font-size: var(--text-lg);
  }

  .not-found__terminal {
    width: 100%;
    max-width: 36rem;
  }
  .shell__line {
    margin: 0;
    overflow-wrap: anywhere;
  }
  .shell__line--error {
    color: var(--color-muted);
  }
  .shell__prompt {
    margin-right: 1ch;
    color: var(--color-accent-text);
  }

  .not-found__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
    margin-top: var(--space-2);
  }

  @media (prefers-reduced-motion: no-preference) {
    .not-found__inner {
      animation: fade-up var(--dur) var(--ease-out) both;
    }
  }
</style>
