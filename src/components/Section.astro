---
/** A page section with its numbered title (`01. About`) and anchor. */
interface Props {
  /** Anchor id of the section (also used to label it). */
  id: string
  /** Position of the section in the page, shown as a two-digit number. */
  index: number
  title: string
}

const { id, index, title } = Astro.props
const titleId = `${id}-title`
const number = String(index).padStart(2, '0')
---

<section class="section" id={id} aria-labelledby={titleId}>
  <div class="section__inner container">
    <h2 class="section__title" id={titleId}>
      <span class="section__index" aria-hidden="true">
        {number}.
      </span>
      {title}
    </h2>
    <slot />
  </div>
</section>

<style>
  .section {
    padding-block: var(--space-9);
  }
  .section__title {
    display: flex;
    align-items: center;
    gap: var(--space-3);
    margin: 0 0 var(--space-6);
    font-size: var(--text-2xl);
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .section__index {
    font-family: var(--font-mono);
    font-size: 0.75em;
    font-weight: 500;
    color: var(--color-accent-text);
  }
  .section__title::after {
    content: '';
    flex: 1;
    max-width: 16rem;
    height: 1px;
    margin-left: var(--space-3);
    background: var(--color-border);
  }

  /* Fades in while scrolling into view; without support, simply shown. */
  @media (prefers-reduced-motion: no-preference) {
    @supports (animation-timeline: view()) {
      /* Longhands only: the CSS minifier (lightningcss) folds a timeline
         into an `animation` shorthand, which browsers then reject. */
      .section__inner {
        animation-name: fade-up;
        animation-timing-function: linear;
        animation-fill-mode: both;
        animation-timeline: view();
        animation-range: entry 0% entry 40%;
      }
    }
  }
</style>
