---
import { Picture, getImage } from 'astro:assets'

import {
  MEGA_SERIES,
  MEGA_SERIES_FIGURES,
  MEGA_SERIES_SCREENSHOTS,
  MEGA_SERIES_SECTIONS,
} from '../data/mega-series'
import { PROJECTS } from '../data/profile'
import { UI, sectionHref, type Lang } from '../i18n/ui'

import ArchitectureDiagram from './ArchitectureDiagram.astro'
import Button from './Button.astro'
import Section from './Section.astro'
import TagList from './TagList.astro'
import TerminalWindow from './TerminalWindow.astro'

/** Body of the mega-series project page. */
interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = UI[lang]

const project = PROJECTS.find((item) => item.name === 'mega-series')
if (!project) throw new Error('mega-series is missing from PROJECTS (src/data/profile.ts).')
const hostname = new URL(project.url).hostname
const backHref = sectionHref(lang, 'projects')

// Each screenshot opens its full-size version.
const screenshots = await Promise.all(
  MEGA_SERIES_SCREENSHOTS.map(async (shot) => ({
    ...shot,
    full: await getImage({ src: shot.image, format: 'webp' }),
  }))
)
---

<header class="intro">
  <div class="intro__inner container">
    <a class="back-link" href={backHref}>
      <span aria-hidden="true">←</span>
      {t.backToProjects}
    </a>

    <p class="intro__path">{MEGA_SERIES.path[lang]}</p>
    <div class="intro__heading">
      <h1 class="intro__title">{project.name}</h1>
      <p class="intro__status">
        <span class="intro__dot" aria-hidden="true"></span>
        {t.inProduction}
      </p>
    </div>
    <p class="intro__pitch">{MEGA_SERIES.pitch[lang]}</p>
    <Button href={project.url} external>
      {hostname}
      <span aria-hidden="true">↗</span>
    </Button>
    <TagList items={project.stack} label={t.stackLabel} />

    <ul class="figures" aria-describedby="figures-note">
      {MEGA_SERIES_FIGURES.map((figure) => (
        <li class="figure">
          <span class="figure__value">{figure.value[lang]}</span>{' '}
          <span class="figure__label">{figure.label[lang]}</span>
        </li>
      ))}
    </ul>
    <p class="figures__note" id="figures-note">
      {MEGA_SERIES.figuresNote[lang]}
    </p>
  </div>
</header>

{MEGA_SERIES_SECTIONS.map((section, i) => (
  <Section id={section.id[lang]} index={i + 1} title={section.title[lang]}>
    {section.intro && <p class="lead">{section.intro[lang]}</p>}
    {section.key === 'architecture' && <ArchitectureDiagram lang={lang} />}
    {section.points.length > 0 && (
      <ul class="prompt-list points">
        {section.points.map((point) => (
          <li>{point[lang]}</li>
        ))}
      </ul>
    )}
    {section.key === 'screenshots' && (
      <ul class="gallery">
        {screenshots.map((shot) => (
          <li>
            <figure class="shot">
              <a class="shot__link" href={shot.full.src}>
                <TerminalWindow title={shot.url} flush>
                  <Picture
                    src={shot.image}
                    formats={['avif', 'webp']}
                    fallbackFormat="webp"
                    widths={[600, 900, 1200]}
                    sizes="(min-width: 72rem) 35rem, (min-width: 48rem) 50vw, 100vw"
                    alt={shot.alt[lang]}
                  />
                </TerminalWindow>
              </a>
              <figcaption class="shot__caption">{shot.caption[lang]}</figcaption>
            </figure>
          </li>
        ))}
      </ul>
    )}
  </Section>
))}

<div class="outro container">
  <a class="back-link" href={backHref}>
    <span aria-hidden="true">←</span>
    {t.backToProjects}
  </a>
  <div class="outro__actions">
    <Button href={sectionHref(lang, 'contact')} variant="ghost">
      {MEGA_SERIES.demoRequest[lang]}
    </Button>
    <Button href={project.url} variant="ghost" external>
      {hostname}
      <span aria-hidden="true">↗</span>
    </Button>
  </div>
</div>

<style>
  .intro {
    padding-block: var(--space-7) var(--space-4);
  }
  .intro__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: var(--space-4);
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    text-decoration: none;
  }
  .back-link:hover {
    color: var(--color-accent-text);
    text-decoration: underline;
  }

  .intro__path {
    margin: var(--space-4) 0 0;
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: var(--text-sm);
  }
  .intro__heading {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3) var(--space-5);
  }
  .intro__title {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--text-hero);
    font-weight: 700;
    letter-spacing: -0.03em;
  }
  .intro__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    margin: 0;
    padding: var(--space-1) var(--space-3);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-md);
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .intro__dot {
    width: 0.5rem;
    height: 0.5rem;
    border-radius: 50%;
    background: var(--color-accent);
  }
  .intro__pitch {
    max-width: 46rem;
    margin: 0;
    font-size: var(--text-lg);
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--space-3);
    width: 100%;
    margin: var(--space-5) 0 0;
    padding: 0;
    list-style: none;
  }
  .figure {
    display: flex;
    flex-direction: column;
    gap: var(--space-1);
    padding: var(--space-4);
    border: 1px solid var(--color-border);
    border-radius: var(--radius-lg);
    background: var(--color-surface);
  }
  .figure__value {
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: var(--text-2xl);
    font-weight: 700;
    line-height: 1.1;
  }
  .figure__label {
    color: var(--color-muted);
    font-size: var(--text-sm);
    line-height: 1.4;
  }
  .figures__note {
    margin: 0;
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }

  .lead,
  .points {
    max-width: 48rem;
  }
  .lead {
    margin: 0 0 var(--space-5);
    font-size: var(--text-lg);
  }

  .gallery {
    display: grid;
    gap: var(--space-6) var(--space-5);
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .shot {
    margin: 0;
  }
  .shot__link {
    display: block;
    border-radius: var(--radius-lg);
    text-decoration: none;
  }
  .shot__link:hover {
    box-shadow: 0 0 0 1px var(--color-accent-text);
  }
  .shot__link :global(img) {
    display: block;
    width: 100%;
    height: auto;
  }
  .shot__caption {
    margin-top: var(--space-3);
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .outro {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--space-4);
    padding-bottom: var(--space-9);
  }
  .outro__actions {
    display: flex;
    flex-wrap: wrap;
    gap: var(--space-3);
  }

  @media (min-width: 48rem) {
    .gallery {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 64rem) {
    .figures {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
