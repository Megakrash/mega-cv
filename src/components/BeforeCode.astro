---
import { PAST_CAREER } from '../data/profile'
import { UI, type Lang } from '../i18n/ui'

import DateRange from './DateRange.astro'
import TagList from './TagList.astro'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = UI[lang]
---

<div class="before__intro">
  <p>{PAST_CAREER.intro[lang]}</p>
  <TagList items={PAST_CAREER.strengths[lang]} label={t.strengthsLabel} />
</div>

<ol class="positions">
  {PAST_CAREER.positions.map((position) => (
    <li class="card position">
      <p class="position__period">
        <DateRange period={position} lang={lang} />
      </p>
      <h3 class="position__organization">{position.organization}</h3>
      {'about' in position && <p class="position__about">{position.about[lang]}</p>}
      <p class="position__role">{position.role[lang]}</p>
      <p class="position__details">{position.details[lang]}</p>
    </li>
  ))}
</ol>

<h3 class="comment-heading">{t.associationsTitle}</h3>
<ul class="associations">
  {PAST_CAREER.associations.map((association) => (
    <li>
      <strong class="associations__name">{association.organization}</strong>
      {'about' in association && <span>, {association.about[lang]}</span>}
      <span class="associations__meta">
        {' · '}
        {association.role[lang]}
        {' · '}
        <DateRange period={association} lang={lang} />
      </span>
    </li>
  ))}
</ul>

<style>
  .before__intro {
    display: grid;
    gap: var(--space-5);
    max-width: 42rem;
  }
  .before__intro p {
    margin: 0;
  }

  .positions {
    display: grid;
    gap: var(--space-5);
    margin: var(--space-7) 0 0;
    padding: 0;
    list-style: none;
  }
  .position__period {
    margin: 0;
    color: var(--color-accent-text);
    font-family: var(--font-mono);
    font-size: var(--text-xs);
  }
  .position__organization {
    margin: var(--space-2) 0 0;
    font-size: var(--text-lg);
    line-height: 1.3;
  }
  .position__about {
    margin: var(--space-1) 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }
  .position__role {
    margin: var(--space-3) 0 0;
    font-family: var(--font-mono);
    font-size: var(--text-sm);
    font-weight: 500;
  }
  .position__details {
    margin: var(--space-2) 0 0;
    color: var(--color-muted);
    font-size: var(--text-sm);
  }

  .associations {
    display: grid;
    gap: var(--space-2);
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: var(--text-sm);
  }
  .associations__name {
    font-weight: 600;
  }
  .associations__meta {
    color: var(--color-muted);
  }

  @media (min-width: 64rem) {
    .positions {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }
</style>
