---
import { HOME_PATHS, LINKEDIN_URL, UI, otherLang, type Lang } from '../i18n/ui'

interface Props {
  lang: Lang
}

const { lang } = Astro.props
const t = UI[lang]
const other = otherLang(lang)
---

<main class="hero">
  <a class="hero__lang" href={HOME_PATHS[other]} hreflang={other} lang={other}>
    {t.switchLanguage}
  </a>

  <h1 class="hero__name">Jonathan Scattolini</h1>
  <p class="hero__title">{t.jobTitle}</p>
  <p class="hero__tagline">{t.tagline}</p>

  <p class="hero__status">{t.status}</p>
  <p class="hero__text">{t.linkedinIntro}</p>
  <a class="hero__link" href={LINKEDIN_URL} rel="noopener noreferrer">
    {t.linkedinLabel} →
  </a>
</main>

<style>
  .hero {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    max-width: 40rem;
    margin: 0 auto;
    padding: 3rem 1rem;
  }
  .hero__lang {
    align-self: flex-end;
    margin-bottom: auto;
    font-family: var(--font-mono);
    font-size: 0.875rem;
    color: var(--color-muted);
  }
  .hero__lang:hover {
    color: var(--color-accent);
  }
  .hero__name {
    margin: 0;
    font-size: clamp(2rem, 7vw, 3.25rem);
    line-height: 1.1;
  }
  .hero__title {
    margin: 0.5rem 0 0;
    font-family: var(--font-mono);
    font-size: 1.25rem;
    color: var(--color-accent);
  }
  .hero__tagline {
    margin: 0.25rem 0 0;
    color: var(--color-muted);
  }
  .hero__status {
    margin: 2.5rem 0 0;
    font-weight: 600;
  }
  .hero__text {
    margin: 0.25rem 0 0;
  }
  .hero__link {
    align-self: flex-start;
    margin: 0.75rem 0 auto;
    font-family: var(--font-mono);
    color: var(--color-accent);
  }
</style>
